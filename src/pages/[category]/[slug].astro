---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import '../../styles/global.css';
import {
  getArticleData,
  getAllArticleSlugs,
  getRecentArticlesAcrossCategories,
  type ArticleCard,
  type ArticleDetail,
} from '../../lib/wp-api';
import { resolveCategoryNeighbors, resolveRelatedTiles } from '../../lib/related';
import { mockArticleDetail } from '../../data/mock-data';
import { CATEGORIES } from '../../lib/constants';
import { withDropCap } from '../../lib/dropcap';
import { needsTakeawaysAnchor } from '../../lib/takeaways-anchor';
import { buildArticleAnchors } from '../../lib/heading-anchor';
import { injectInternalLinks } from '../../lib/internal-links';
import { isIndexExcluded } from '../../lib/index-exclusions';

/** Decode common HTML entities (&#038; → &, &#8217; → ', etc.) */
function decodeHtmlEntities(str: string): string {
  return str
    .replace(/&#(\d+);/g, (_m, code) => String.fromCharCode(Number(code)))
    .replace(/&amp;/g, '&')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"')
    .replace(/&apos;/g, "'");
}


export async function getStaticPaths() {
  let slugs: Awaited<ReturnType<typeof getAllArticleSlugs>>;
  try {
    slugs = await getAllArticleSlugs();
  } catch (err) {
    // Mock fallback ONLY for local dev (`astro dev`); production builds must
    // fail so a CMS outage can never publish a single-page demo site.
    if (!import.meta.env?.DEV) throw err;
    slugs = [{
      id: mockArticleDetail.id,
      title: mockArticleDetail.title,
      slug: mockArticleDetail.slug,
      excerpt: mockArticleDetail.excerpt,
      date: mockArticleDetail.date,
      modified: mockArticleDetail.modified,
      image: mockArticleDetail.image,
      imageAlt: mockArticleDetail.imageAlt,
      category: mockArticleDetail.category,
      categorySlug: mockArticleDetail.category.slug,
      readTime: mockArticleDetail.readTime,
    }];
  }

  // Filter out posts whose category is not in our known list, so we don't
  // create routes that conflict with /categories/[slug]/, /about/, etc.
  const knownSlugs = new Set(CATEGORIES.map((c) => c.slug));

  const published = slugs.filter((article) => knownSlugs.has(article.categorySlug));
  const byCategory = new Map<string, ArticleCard[]>();
  for (const article of published) {
    const articles = byCategory.get(article.categorySlug) || [];
    articles.push(article);
    byCategory.set(article.categorySlug, articles);
  }

  return published.map((article) => ({
    params: { category: article.categorySlug, slug: article.slug },
    props: {
      categoryNeighbors: resolveCategoryNeighbors(
        byCategory.get(article.categorySlug) || [],
        article.slug,
      ),
    },
  }));
}

const { category, slug } = Astro.params;
const { categoryNeighbors = [] } = Astro.props as { categoryNeighbors?: ArticleCard[] };
let article: ArticleDetail;
try {
  article = await getArticleData(slug!);
} catch (err) {
  // Mock fallback ONLY for local dev; production builds fail on article
  // data errors instead of silently rendering demo content.
  if (!import.meta.env?.DEV) throw err;
  article = mockArticleDetail;
}

function normalizeOverviewItems(items: ArticleDetail['quickOverview']) {
  return items
    .map((item) => ({
      label: typeof item.statLabel === 'string' ? item.statLabel.trim() : '',
      value: typeof item.statValue === 'string' ? item.statValue.trim() : '',
    }))
    .filter((item) => item.label.length > 0 && item.value.length > 0);
}

const overviewItems = normalizeOverviewItems(article.quickOverview);

const takeaways = article.keyTakeaways.map((item) => item.takeawayText);
// TOC links to #key-takeaways whenever field takeaways exist; posts whose
// takeaways live only in the ACF field have no in-content H2 to anchor to.
const takeawaysAnchor = needsTakeawaysAnchor(article.content, takeaways.length);
const sources = article.sources;
const { html: contentWithIds, tocItems } = buildArticleAnchors(article.content, takeaways.length > 0, sources.length);

// Phase 2.1: resolve Related Articles tiles
// Cross-cat pool is module-level memoized in wp-api.ts so this fires
// at most once per build across all 25 article-page renders.
const crossCategoryPool = await getRecentArticlesAcrossCategories();
const relatedTiles = resolveRelatedTiles({
  sameCategory: categoryNeighbors.length > 0 ? categoryNeighbors : article.relatedArticles,
  crossCategoryPool,
  currentArticleId: article.id,
  currentPrimaryCategorySlug: article.category.slug,
});
---

<ArticleLayout
  title={article.title}
  description={article.excerpt}
  datePublished={article.date}
  dateModified={article.modified}
  readTime={`${article.readTime} min`}
  category={article.category.name}
  categorySlug={article.category.slug}
  overviewItems={overviewItems}
  takeaways={takeaways}
  takeawaysAnchor={takeawaysAnchor}
  sources={sources}
  tocItems={tocItems}
  ogImage={article.image}
  focusKeywords={article.focusKeywords}
  lastUpdated={article.lastUpdated}
  relatedTiles={relatedTiles}
  faqItems={article.faqItems}
  noindex={isIndexExcluded(category!, slug!)}
>
  <Fragment set:html={withDropCap(injectInternalLinks(contentWithIds, slug!))} />
</ArticleLayout>
